# ==============================================================================
# Paytm AI ActionMate — Production Environment Configuration
# Commercial SaaS Merchant Intelligence & Autonomous Business Growth Platform
# ==============================================================================

# Environment Mode: 'production' for live merchant operations, 'demo' for sandbox testing
ENVIRONMENT=production

# Server Port (Default: 8000)
DEALPILOT_PORT=8000

# Database Configuration (Default: dealpilot.db SQLite in WAL mode)
DATABASE_PATH=dealpilot.db

# Sarvam AI Indic Voice Stack API Key
# Required for Indic speech-to-text (Saaras) and text-to-speech (Bulbul) in 8 Indic languages.
# Obtain your API key from the Sarvam AI dashboard: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Allowed CORS Origins (Comma-separated for multi-domain production deployments)
CORS_ORIGIN=https://actionmate.paytm.com,http://localhost:8000

# Merchant Authorization Secret (HMAC-SHA256 signature key for human approval gates)
ACTIONMATE_HMAC_SECRET=your_production_hmac_secret_key_here

# Paytm Soundbox 4G Telemetry Endpoint (Optional webhook URL for live audio dispatch)
PAYTM_SOUNDBOX_WEBHOOK_URL=https://soundbox-api.paytm.com/v1/telemetry

# Production SMS / WhatsApp Business API Gateway (Required for live customer dispatch)
WHATSAPP_BUSINESS_API_TOKEN=your_whatsapp_or_sms_gateway_token_here

